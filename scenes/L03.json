    {
      "short": "Almacenamiento",
      "chapter": "technique",
      "title": "Los datos caben; las fotos, no",
      "body": "Almacenamiento = tamaño × elementos al día × 365 × años. Los datos de cada foto (1 KB) en 5 años: **~1,8 TB**, caben en una base de datos. Las fotos (2 MB): **~3,7 PB**. No caben en ninguna máquina: van a un almacén de ficheros repartido entre muchas.",
      "callout": {
        "type": "tip",
        "text": "Para el tamaño de una fila, suma sus campos y redondea hacia arriba: los índices también ocupan."
      },
      "changes": [
        "+ Almacén repartido para las fotos",
        "~ Base de datos: solo los datos de cada foto"
      ],
      "metrics": {
        "reads": 30000,
        "writes": 30,
        "storage": "~3,7 PB",
        "bw": null
      },
      "panel": {
        "title": "La cuenta",
        "rows": [
          {
            "text": "Datos: 1 KB × 10⁶ × 365 × 5 ≈ 1,8 TB",
            "tone": "good"
          },
          {
            "text": "Fotos: 2 MB × 10⁶ × 365 × 5 ≈ 3,7 PB",
            "tone": "bad"
          },
          {
            "text": "Las versiones del feed: un 10 % más. No cambia nada."
          }
        ]
      },
      "predict": {
        "q": "Cada vista descarga la versión del feed, de 200 KB, y hay ~10.000 vistas por segundo. ¿Cuánto sale hacia los usuarios?",
        "options": [
          "~2 MB por segundo",
          "~200 MB por segundo",
          "~2 GB por segundo",
          "~20 GB por segundo"
        ],
        "answer": 2,
        "explain": "2 × 10⁵ bytes × 10⁴ por segundo = 2 × 10⁹ bytes: ~2 GB/s, que en la red son 16 Gbit/s. 200 MB/s sale si tratas los 200 KB como 20 KB; es el despiste típico al pasar de KB a GB."
      },
