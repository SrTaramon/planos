      "predict": {
        "q": "Hay 10⁹ vistas al día. Si redondeas el día a 10⁵ segundos, ¿cuántas lecturas por segundo salen?",
        "options": [
          "~1.000 por segundo",
          "~10.000 por segundo",
          "~100.000 por segundo",
          "~1.000.000 por segundo"
