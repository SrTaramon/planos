    {
      "short": "QPS",
      "chapter": "technique",
      "title": "De usuarios a peticiones por segundo",
      "body": "QPS medio = DAU × acciones al día / 86.400. Redondea el día a **10⁵** segundos y las cuentas salen de cabeza: dividir es restar exponentes. Subidas: 10⁶ / 10⁵ = **10 por segundo**. Vistas: 10⁹ / 10⁵ = **10.000 por segundo**.",
      "callout": {
        "type": "tip",
        "text": "Con 86.400 exacto salen 12 y 11.574 por segundo: el truco se queda un 14 % corto, y para decidir da igual."
      },
      "changes": [
        "+ Escrituras: ~10/s",
        "+ Lecturas: ~10.000/s"
      ],
      "metrics": {
        "reads": 10000,
        "writes": 10,
        "storage": null,
        "bw": null
      },
      "panel": {
        "title": "La cuenta",
        "rows": [
          {
            "text": "QPS = DAU × acciones / 86.400 ≈ … / 10⁵"
          },
          {
            "text": "Subidas: 10⁶ / 10⁵ = ~10/s"
          },
          {
            "text": "Vistas: 10⁹ / 10⁵ = 10⁴ = ~10.000/s"
          }
        ]
      },
