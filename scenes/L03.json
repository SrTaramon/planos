  "steps": [
    {
      "short": "¿Cuánto?",
      "chapter": "problem",
      "title": "Una app de fotos: ¿una máquina o cien?",
      "body": "10 millones de personas al día suben y ven fotos. Antes de dibujar cajas, unas cuentas de servilleta. No buscan el número exacto, sino el **orden de magnitud**: si sale 30 o 50 por segundo, el diseño es el mismo; si sale 30 o 30.000, no.",
      "callout": {
        "type": "insight",
        "text": "Son el paso 2 del método: 3-5 minutos, no más. Y cada cuenta se cierra con una decisión de diseño."
      },
      "metrics": {
        "reads": null,
        "writes": null,
        "storage": null,
        "bw": null
      },
      "panel": {
        "title": "Supuestos",
        "rows": [
          {
            "text": "10⁷ usuarios activos al día (DAU)"
          },
          {
            "text": "1 de cada 10 sube una foto: 10⁶ al día"
          },
          {
            "text": "Cada uno ve 100 fotos: 10⁹ vistas al día"
          },
          {
            "text": "Foto: 2 MB · del feed: 200 KB · sus datos: 1 KB"
          },
          {
            "text": "Pico: 3 × la media · todo se guarda 5 años"
          }
